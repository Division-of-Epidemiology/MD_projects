geom_col(fill = "#2C7FB8") +
scale_x_date(date_labels = "%b %Y", date_breaks = "1 month") +
labs(
title = "Monthly Unique PIN Counts",
subtitle = "July 2025 – July 2026",
x = "Month",
y = "Count"
) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
