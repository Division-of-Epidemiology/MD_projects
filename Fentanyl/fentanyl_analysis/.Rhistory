##regression
reg_meth <- lm(Meth_ct ~ fent_meth, data = sub_data)
summary(reg_meth)
##regression
reg_meth <- glm(Meth_ct ~ fent_meth, data = sub_data, family = poisson)
summary(reg_meth)
nb_meth <- glm.nb(Meth_ct ~ fent_meth, data = sub_data)
summary(nb_meth)
